# Copia este archivo como .env y llena los valores. NUNCA subas el .env al repositorio.
# Los valores reales se piden al equipo.

# Puerto donde escucha el servidor (por defecto 3000)
PORT=3000

# Cadena de conexión de PostgreSQL (Neon en producción). Si se deja vacía, la app
# arranca igual y /health responde db: "sin configurar".
# Formato: postgresql://usuario:contraseña@host/basedatos?sslmode=require
DATABASE_URL=

# Contraseña del panel del técnico (se usará en una historia posterior)
TECNICO_PASSWORD=
